# Gmail account used by the backend to send OTP emails. Store real values in Render, never in Git.
GMAIL_USERNAME=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=replace_with_google_app_password

# Optional: use a long random value to hash OTPs separately from the Gmail App Password.
OTP_HASH_SECRET=replace_with_a_long_random_secret

# Contact details shown in OTP emails. Set the real values in Render, not Git.
OTP_SUPPORT_EMAIL=your-support-email@example.com
OTP_SUPPORT_PHONE=your-support-phone-number
