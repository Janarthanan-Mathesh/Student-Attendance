# Resend API key. Store the real key in Render environment settings, never in Git.
RESEND_API_KEY=re_replace_with_a_real_secret

# Must be an address using a domain verified in your Resend account.
OTP_FROM_EMAIL=Attendance Portal <otp@your-verified-domain.example>

# Optional: use a long random value to hash OTPs separately from the Resend key.
OTP_HASH_SECRET=replace_with_a_long_random_secret
